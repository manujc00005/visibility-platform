# Visibility Platform — environment variables.
# Copy to .env.local (never committed) and fill in.

# PostgreSQL connection string.
# Neon (target):   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
#                  App traffic uses the pooled ("-pooler") URL; migrations use DATABASE_URL_UNPOOLED.
# Local fallback:  postgresql://visibility:visibility@127.0.0.1:5433/visibility
#                  (docker run -d --name visibility-postgres -e POSTGRES_USER=visibility \
#                   -e POSTGRES_PASSWORD=visibility -e POSTGRES_DB=visibility \
#                   -p 127.0.0.1:5433:5432 postgres:16)
DATABASE_URL=

# Neon only: direct (non "-pooler") connection used by migrations. `neon env pull` writes it.
DATABASE_URL_UNPOOLED=

# Google PageSpeed Insights API key (optional). Create one in Google Cloud Console
# (APIs & Services > Credentials) with the PageSpeed Insights API enabled.
# Without it the audit's performance section shows "not configured".
PAGESPEED_API_KEY=

# AI visibility (Phase 4). DataForSEO API credentials (app.dataforseo.com > API access).
# Without them only assisted (manual) measurements are available.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Monthly spending cap for paid providers, decimal USD. Empty = no paid calls (fail-closed).
GEO_MONTHLY_BUDGET_USD=
# Set to true ONLY after DataForSEO confirms in writing that their data may appear in
# client reports. Until then, paid measurements are excluded from PDFs.
DATAFORSEO_REDISTRIBUTION_CONFIRMED=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Integration tests ONLY (put it in .env.test.local, never in .env.local).
# Neon branch "test", database whose name ends in "_test", direct connection.
# Prepare once with: npm run db:test:prepare
# TEST_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/visibility_test?sslmode=require
